# Local development uses a file-based SQLite database (zero setup).
# Copy this file to `.env` before running the app:  cp .env.example .env
DATABASE_URL="file:./dev.db"

# --- Production (later) ---
# When we move to Supabase, DATABASE_URL becomes the Supabase Postgres
# connection string and the Prisma provider switches to "postgresql".
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"
